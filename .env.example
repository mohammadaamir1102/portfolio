# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------
# Canonical production URL. Used for metadata, sitemap, robots and JSON-LD.
# Set this in Vercel to your custom domain, e.g. https://mohammadaamir.dev
NEXT_PUBLIC_SITE_URL=https://mohammad-aamir.vercel.app

# ---------------------------------------------------------------------------
# GitHub showcase (optional)
# ---------------------------------------------------------------------------
# Public username is configured in src/data/github.ts.
# A token is optional. Without it the GitHub API allows 60 requests/hour per IP,
# which is plenty because the showcase is revalidated hourly. The token is only
# read on the server and is never sent to the browser.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Contact form delivery (optional)
# ---------------------------------------------------------------------------
# The form validates on the client and the server. It only sends email when all
# three variables below are present. Otherwise the UI clearly falls back to a
# pre-filled mailto: link and tells the visitor delivery is not configured.
#
# Create a free API key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Where enquiries should arrive
CONTACT_TO_EMAIL=m.aamirtech1119@gmail.com
